# ==============================================================================
# Armonía del Ser — Homelab Sites Environment Configuration
# ==============================================================================

# Routing & Platform
SERVICE_DOMAIN=armonia.roadtotech.me
PROXY_NETWORK=proxy-net

# Runtime & Auth Strategy
# AUTH_PROVIDER="proxy_headers" trusts Authelia ForwardAuth headers (Remote-Email, Remote-Groups)
# mapping LLDAP groups: armonia-owner -> OWNER, armonia-assistant -> ASSISTANT
APP_ENV=production
ENVIRONMENT=production
AUTH_PROVIDER=proxy_headers

# Database Configuration
# Active: Local SQLite volume mount at ./data/armonia.db (mounted to /data/armonia.db in container)
DATABASE_URL=file:/data/armonia.db
DATABASE_AUTH_TOKEN=

# Deferred Turso Cloud Configuration (tracked in armonia-del-ser/armonia-api#11):
# TURSO_URL=libsql://armonia-db-kiskaadee.aws-us-east-2.turso.io
# DATABASE_URL=sqlite+libsql://armonia-db-kiskaadee.aws-us-east-2.turso.io?authToken=<YOUR_TURSO_TOKEN>&secure=true
# DATABASE_AUTH_TOKEN=<YOUR_TURSO_TOKEN>

# Business Profile
THERAPIST_NAME="Jasmin"
BUSINESS_NAME="Armonía del Ser"
WHATSAPP_PHONE="527751487912"
SPEI_CLABE="012345678901234567"
SPEI_BANK="BBVA"
SPEI_BENEFICIARY="Jasmin"

# Optional Google Calendar Integration
GCAL_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=
